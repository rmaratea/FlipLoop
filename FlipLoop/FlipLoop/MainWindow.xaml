<Window x:Class="FlipLoop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:controls="clr-namespace:FlipLoop.Controls"
        mc:Ignorable="d"
        Title="FlipLoop"
        Width="1280"
        Height="800"
        MinWidth="900"
        MinHeight="600"
        WindowStartupLocation="CenterScreen"
        AllowDrop="True"
        DragEnter="Window_DragEnter"
        Drop="Window_Drop">

    <DockPanel LastChildFill="True">

        <!-- ========================= -->
        <!-- Menu -->
        <!-- ========================= -->

        <Menu DockPanel.Dock="Top">

            <MenuItem Header="_File">

                <MenuItem Header="_Apri..."
                          Click="Open_Click"/>

                <Separator/>

                <MenuItem Header="_Esci"
                          Click="Exit_Click"/>

            </MenuItem>

        </Menu>

        <!-- ========================= -->
        <!-- Toolbar -->
        <!-- ========================= -->

        <ToolBar DockPanel.Dock="Top">

            <Button Width="80"
                    Content="Apri"
                    Click="Open_Click"/>

            <Separator/>

            <TextBlock Text="BPM:"
                       VerticalAlignment="Center"
                       Margin="10,0,4,0"/>

            <TextBlock x:Name="BpmLabel"
                       Width="60"
                       VerticalAlignment="Center"
                       Text="--"/>

            <Separator/>

            <CheckBox x:Name="GhostPlayCheck"
                      Content="Ghost Play"
                      VerticalAlignment="Center"/>

        </ToolBar>

        <!-- ========================= -->
        <!-- Barra informazioni -->
        <!-- ========================= -->

        <Border DockPanel.Dock="Top"
                Background="#202020"
                Padding="8">

            <Grid>

                <Grid.ColumnDefinitions>

                    <ColumnDefinition Width="Auto"/>

                    <ColumnDefinition Width="*"/>

                </Grid.ColumnDefinitions>

                <TextBlock
                    Text="File:"
                    Foreground="White"
                    FontWeight="SemiBold"/>

                <TextBlock
                    x:Name="FileNameLabel"
                    Grid.Column="1"
                    Margin="8,0,0,0"
                    Foreground="White"
                    Text="Nessun file aperto"/>

            </Grid>

        </Border>

        <!-- ========================= -->
        <!-- Waveform -->
        <!-- ========================= -->

        <Grid Background="#2B2B2B">

            <controls:WaveformControl
                x:Name="Waveform"
                Margin="10"/>

        </Grid>

        <!-- ========================= -->
        <!-- StatusBar -->
        <!-- ========================= -->

        <StatusBar DockPanel.Dock="Bottom">

            <StatusBarItem>

                <TextBlock
                    x:Name="StatusText"
                    Text="Pronto"/>

            </StatusBarItem>

        </StatusBar>

    </DockPanel>

</Window>