<Window x:Class="FlipLoop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FlipLoop"
        Height="720"
        Width="1200"
        WindowStartupLocation="CenterScreen">

    <DockPanel>

        <Menu DockPanel.Dock="Top">

            <MenuItem Header="_File">

                <MenuItem Header="Apri..."
                          Click="Open_Click"/>

                <Separator/>

                <MenuItem Header="Esci"
                          Click="Exit_Click"/>

            </MenuItem>

        </Menu>

        <ToolBar DockPanel.Dock="Top">

            <Button Content="Apri"
                    Width="80"
                    Click="Open_Click"/>

            <Separator/>

            <TextBlock Text="BPM:"
                       Margin="10,0,4,0"
                       VerticalAlignment="Center"/>

            <TextBlock x:Name="BpmLabel"
                       Text="--"
                       Width="60"/>

            <Separator/>

            <CheckBox x:Name="GhostPlayCheck"
                      Content="Ghost Play"/>

        </ToolBar>

        <Grid>

            <Border Margin="20"
                    BorderBrush="Gray"
                    BorderThickness="1">

                <TextBlock
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    FontSize="20"
                    Foreground="Gray"
                    Text="Waveform (arriva nello Sprint 2)"/>

            </Border>

        </Grid>

    </DockPanel>

</Window>